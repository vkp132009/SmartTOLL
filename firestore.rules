rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function isManager() {
      return signedIn()
        && get(profilePath(request.auth.uid)).data.role == 'manager'
        && get(profilePath(request.auth.uid)).data.accessStatus == 'active';
    }

    function validProfileCreate(userId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'uid', 'username', 'displayName', 'requestedRole', 'role',
          'accessStatus', 'plazaId', 'createdAt'
        ])
        && data.keys().hasOnly([
          'uid', 'username', 'displayName', 'requestedRole', 'role',
          'accessStatus', 'plazaId', 'createdAt'
        ])
        && data.uid == userId
        && data.username is string
        && data.username.matches('^[a-z0-9][a-z0-9_-]{1,29}$')
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.requestedRole in ['operator', 'manager']
        && data.role == 'operator'
        && (
          (data.requestedRole == 'operator'
            && data.accessStatus == 'active'
            && data.plazaId == 'toll-1')
          || (data.requestedRole == 'manager'
            && data.accessStatus == 'pending'
            && data.plazaId == null)
        )
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isManager());
      allow list: if isManager();
      allow create: if signedIn()
        && request.auth.uid == userId
        && validProfileCreate(userId);
      allow update: if isManager()
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /tollRecords/{recordId} {
        allow read, create, update, delete: if signedIn()
          && (request.auth.uid == userId || isManager());
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}